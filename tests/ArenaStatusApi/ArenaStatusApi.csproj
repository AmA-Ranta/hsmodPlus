<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ArenaBoxBot\ArenaStatusProjection.cs" Link="ArenaStatusProjection.cs" />
    <!-- The game's stripped Unity assembly cannot run under the test CLR.
         Compile production against that DLL; exercise the linked projection
         with the SDK's complete Newtonsoft 13, as the ArenaPolicy suite does. -->
    <Reference Include="Newtonsoft.Json"><HintPath>$(MSBuildToolsPath)\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
